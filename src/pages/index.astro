---
import { homepage } from '../content/articles.js';
import '../styles/global.css';
import journalScript from '../scripts/journal.js?raw';
---
<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>金心香連｜大女孩愛咪</title>
